+impl ExternalTalkLease {
+    pub fn settle_unstarted(&mut self, now: Time) -> Option<&'static str> {
+        if self.outcome.is_none() && !self.started {
+            if self.cancelled {
+                self.outcome = Some("cancelled_before_native_action");
+            } else if now.0 >= self.expires_at.0 {
+                self.outcome = Some("expired_before_native_action");
+            }
+        }
+        self.outcome
+    }
