+/// Append a structured event only when the opt-in telemetry path is set.
+/// Record count, total bytes, elapsed time and individual record size are capped.
+pub(crate) fn external_telemetry(event: serde_json::Value) {
+    let Some(path) = std::env::var_os("VELOREN_NATIVE_EVENTS").map(PathBuf::from) else {
+        return;
+    };
+    static TELEMETRY_BUDGET: OnceLock<Mutex<ExternalTelemetryBudget>> = OnceLock::new();
+    let Ok(mut budget) = TELEMETRY_BUDGET
+        .get_or_init(|| Mutex::new(ExternalTelemetryBudget::from_env()))
+        .lock()
+    else {
+        return;
+    };
+    let Ok(mut record) = serde_json::to_vec(&event) else {
+        return;
+    };
+    record.push(b'\n');
+    if budget.records >= budget.max_records
+        || budget.bytes.saturating_add(record.len()) > budget.max_bytes
+        || budget.started.elapsed() >= budget.max_duration
+        || record.len() > 64 * 1024
+    {
+        return;
+    }
+    if let Ok(mut file) = File::options().create(true).append(true).open(path)
+        && file.write_all(&record).is_ok()
+    {
+        budget.records += 1;
+        budget.bytes += record.len();
+    }
 }
 
