+    /// Retain queued actions while keeping request provenance attached to the
+    /// same action after indices shift.
+    pub fn retain_actions(&mut self, mut keep: impl FnMut(&NpcAction) -> bool) {
+        if self.external_action_request_ids.is_empty() {
+            self.actions.retain(keep);
+            return;
+        }
+
+        let old_request_ids = std::mem::take(&mut self.external_action_request_ids);
+        let mut retained_actions = Vec::with_capacity(self.actions.len());
+        let mut retained_request_ids = HashMap::new();
+
+        for (old_index, action) in std::mem::take(&mut self.actions).into_iter().enumerate() {
+            if keep(&action) {
+                let new_index = retained_actions.len();
+                retained_actions.push(action);
+                if let Some(request_id) = old_request_ids.get(&old_index) {
+                    retained_request_ids.insert(new_index, request_id.clone());
+                }
+            }
+        }
+
+        self.actions = retained_actions;
+        self.external_action_request_ids = retained_request_ids;
+    }
