+
+/// Runs a validated external TalkToNpc request through the existing native
+/// talk action. The lease is independent of Brain lifetime and resettable
+/// controller activity. Native danger, cancellation, and expiry terminate the
+/// lease via StopIf, which calls the wrapped action's native `on_cancel`.
+fn external_talk<S: State>(ctx: &mut NpcCtx) -> Option<impl Action<S> + use<S>> {
+    let lease = ctx.controller.external_talk.as_mut()?;
+    if lease.outcome.is_some() {
+        return None;
+    }
+    lease.started = true;
+    let target = lease.target;
+
+    Some(
+        talk_to::<S>(target)
+            .then(just(move |ctx, _| {
+                if let Some(lease) = &mut ctx.controller.external_talk {
+                    lease.outcome = Some(if lease.action_index.is_some() {
+                        "native_intent_queued"
+                    } else {
+                        "native_talk_completed_without_speech"
+                    });
+                }
+            }))
+            .stop_if(|ctx: &mut NpcCtx| {
+                let reason = if let Some(lease) = &ctx.controller.external_talk {
+                    if lease.cancelled {
+                        Some("cancelled")
+                    } else if ctx.time.0 >= lease.expires_at.0 {
+                        Some("expired")
+                    } else {
+                        None
+                    }
+                } else {
+                    Some("lease_missing")
+                }
+                .or_else(|| (!ctx.inbox.is_empty()).then_some("native_inbox_interrupt"))
+                .or_else(|| {
+                    check_for_enemies::<S>(ctx).map(|_| "native_danger_interrupt")
+                })
+                .or_else(|| {
+                    ctx.data
+                        .quests
+                        .related_to(ctx.npc_id)
+                        .filter_map(|id| ctx.data.quests.get(id))
+                        .any(|quest| quest.timeout.is_some_and(|timeout| ctx.time > timeout))
+                        .then_some("native_quest_timeout_interrupt")
+                });
+
+                if let Some(reason) = reason {
+                    if let Some(lease) = &mut ctx.controller.external_talk {
+                        lease.outcome = Some(reason);
+                    }
+                    true
+                } else {
+                    false
+                }
+            }),
+    )
 }
 
