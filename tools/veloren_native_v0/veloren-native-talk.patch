+#[derive(Clone, Copy)]
+struct TalkCatalogCandidate {
+    position: [f32; 2],
+    loaded: bool,
+    talkable: bool,
+}
+
+fn select_nearby_talk_pairs(
+    candidates: &[TalkCatalogCandidate],
+) -> (Vec<(usize, usize, f32)>, Vec<(usize, usize, f32)>) {
+    let mut loaded = Vec::new();
+    let mut simulated = Vec::new();
+    for from in 0..candidates.len() {
+        for to in from + 1..candidates.len() {
+            let a = candidates[from];
+            let b = candidates[to];
+            let dx = a.position[0] - b.position[0];
+            let dy = a.position[1] - b.position[1];
+            let distance = (dx * dx + dy * dy).sqrt();
+            if distance > 8.0 {
+                continue;
+            }
+            if a.loaded && b.loaded && a.talkable && b.talkable {
+                loaded.push((from, to, distance));
+            } else if !a.loaded && !b.loaded {
+                simulated.push((from, to, distance));
+            }
+        }
+    }
+    let by_distance = |a: &(usize, usize, f32), b: &(usize, usize, f32)| {
+        a.2.total_cmp(&b.2).then_with(|| a.0.cmp(&b.0)).then_with(|| a.1.cmp(&b.1))
+    };
+    loaded.sort_by(by_distance);
+    simulated.sort_by(by_distance);
+    (loaded, simulated)
+}
