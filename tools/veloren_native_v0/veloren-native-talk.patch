+
+fn valid_external_source_ttl(source: &str, ttl: f64) -> bool {
+    !source.is_empty() && source.len() <= 128 && ttl.is_finite() && (0.1..=60.0).contains(&ttl)
+}
+
+fn external_request_conflicts(seen: &HashMap<String, String>, id: &str, payload: &str) -> bool {
+    seen.get(id).is_some_and(|previous| previous != payload)
+}
+
+fn process_external_requests(rtsim: &mut RtSim, now: Time) {
+    let Some(path) = rtsim.external_request_path.clone() else {
+        return;
+    };
+    let Ok(mut file) = std::fs::File::open(path) else {
+        return;
+    };
+    let Ok(file_len) = file.metadata().map(|metadata| metadata.len()) else {
+        return;
+    };
+    if file_len < rtsim.external_request_offset {
+        rtsim.external_request_offset = 0;
+    }
+    if file.seek(SeekFrom::Start(rtsim.external_request_offset)).is_err() {
+        return;
+    }
+    let mut bytes = Vec::new();
+    if file.take(1_000_001).read_to_end(&mut bytes).is_err() {
+        return;
+    }
+    if bytes.len() > 1_000_000 {
+        reject_external_request(None, "request_file_over_1MiB");
+        rtsim.external_request_offset = file_len;
+        return;
+    }
+    let contents = String::from_utf8_lossy(&bytes);
+    let Some(complete_end) = contents.rfind('\n').map(|index| index + 1) else {
+        return;
+    };
+    rtsim.external_request_offset += complete_end as u64;
+
+    for line in contents[..complete_end].lines().filter(|line| !line.trim().is_empty()) {
+        let value: serde_json::Value = match serde_json::from_str(line) {
+            Ok(value) => value,
+            Err(_) => {
+                reject_external_request(None, "invalid_jsonl");
+                continue;
+            },
+        };
+
+        if let Some(cancel_id) = value.get("cancel_request_id").and_then(|v| v.as_str()) {
+            let mut result = "not_found";
+            for npc in rtsim.state.data_mut().npcs.values_mut() {
+                if let Some(lease) = &mut npc.controller.external_talk
+                    && lease.request_id == cancel_id
+                {
+                    if lease.cancelled {
+                        result = "cancel_already_requested";
+                    } else if lease.outcome.is_some() {
+                        result = "cancel_too_late_native_intent_already_queued";
+                    } else {
+                        lease.cancelled = true;
+                        result = "cancel_requested";
+                    }
+                    break;
+                }
+            }
+            crate::rtsim::external_telemetry(serde_json::json!({
+                "event": result,
+                "request_id": cancel_id,
+                "time": now.0,
+            }));
+            continue;
+        }
+
+        let request_id = value.get("request_id").and_then(|v| v.as_str());
+        let Some(request_id) = request_id.filter(|id| !id.is_empty() && id.len() <= 128) else {
+            reject_external_request(None, "missing_or_invalid_request_id");
+            continue;
+        };
+        let canonical = value.to_string();
+        if rtsim.seen_external_requests.contains_key(request_id) {
+            if external_request_conflicts(&rtsim.seen_external_requests, request_id, &canonical) {
+                let conflict_key = format!("conflict:{request_id}");
+                if !rtsim.seen_external_requests.contains_key(&conflict_key) {
+                    rtsim.seen_external_requests.insert(conflict_key, String::new());
+                    reject_external_request(Some(request_id), "request_id_conflict");
+                }
+            }
+            continue;
+        }
+        if rtsim.seen_external_requests.len() >= 4096 {
+            reject_external_request(Some(request_id), "request_id_capacity_reached");
+            continue;
+        }
+        rtsim.seen_external_requests.insert(request_id.to_owned(), canonical);
+
+        let Some(kind) = value.get("kind").and_then(|v| v.as_str()) else {
+            reject_external_request(Some(request_id), "missing_kind");
+            continue;
+        };
+        if kind != "TalkToNpc" {
+            reject_external_request(Some(request_id), "unsupported_kind");
+            continue;
+        }
+        let source = value.get("source").and_then(|v| v.as_str()).unwrap_or("");
+        let ttl = value.get("ttl").and_then(|v| v.as_f64()).unwrap_or(f64::NAN);
+        let Some(npc_uid) = value.get("npc_uid").and_then(|v| v.as_u64()) else {
+            reject_external_request(Some(request_id), "invalid_npc_uid");
+            continue;
+        };
+        let Some(target_uid) = value.get("target_uid").and_then(|v| v.as_u64()) else {
+            reject_external_request(Some(request_id), "invalid_target_uid");
+            continue;
+        };
+        if !valid_external_source_ttl(source, ttl) {
+            reject_external_request(Some(request_id), "invalid_source_or_ttl");
+            continue;
+        }
+
+        let mut data = rtsim.state.data_mut();
+        let from = data.npcs.iter().find_map(|(id, npc)| (npc.uid == npc_uid).then_some(id));
+        let to = data.npcs.iter().find_map(|(id, npc)| (npc.uid == target_uid).then_some(id));
+        let (Some(from), Some(to)) = (from, to) else {
+            reject_external_request(Some(request_id), "npc_or_target_not_found");
+            continue;
+        };
+        let sender = &data.npcs[from];
+        let target = &data.npcs[to];
+        if from == to
+            || sender.is_dead()
+            || target.is_dead()
+            || !matches!(&sender.role, Role::Civilised(_))
+            || !matches!(&target.role, Role::Civilised(_))
+            || !matches!(sender.mode, SimulationMode::Loaded)
+            || !matches!(target.mode, SimulationMode::Loaded)
+            || sender.wpos.xy().distance(target.wpos.xy()) > 8.0
+        {
+            reject_external_request(Some(request_id), "pair_not_live_loaded_civilised_nearby");
+            continue;
+        }
+        if sender
+            .controller
+            .external_talk
+            .as_ref()
+            .is_some_and(|lease| lease.outcome.is_none())
+        {
+            reject_external_request(Some(request_id), "npc_has_active_external_lease");
+            continue;
+        }
+
+        data.npcs[from].controller.external_talk = Some(ExternalTalkLease {
+            request_id: request_id.to_owned(),
+            target: Actor::Npc(to),
+            expires_at: now.add_seconds(ttl),
+            cancelled: false,
+            outcome: None,
+            started: false,
+            action_index: None,
+        });
+        crate::rtsim::external_telemetry(serde_json::json!({
+            "event": "request_accepted",
+            "request_id": request_id,
+            "npc_uid": npc_uid,
+            "source": source,
+            "target_uid": target_uid,
+            "kind": kind,
+            "time": now.0,
+        }));
+    }
+}
