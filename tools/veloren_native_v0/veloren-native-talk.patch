+#[cfg(test)]
+mod native_request_tests {
+    use super::{
+        TalkCatalogCandidate, external_request_conflicts, mark_external_terminal,
+        select_nearby_talk_pairs, valid_external_source_ttl,
+    };
+    use std::collections::{HashMap, HashSet};
+
+    #[test]
+    fn ttl_and_source_bounds_are_enforced() {
+        assert!(valid_external_source_ttl("test-harness", 20.0));
+        assert!(!valid_external_source_ttl("", 20.0));
+        assert!(!valid_external_source_ttl("test-harness", 0.0));
+        assert!(!valid_external_source_ttl("test-harness", 60.1));
+        assert!(!valid_external_source_ttl("test-harness", f64::NAN));
+    }
+
+    #[test]
+    fn request_id_replay_is_distinct_from_conflicting_reuse() {
+        let seen = HashMap::from([("request-1".to_owned(), "same-payload".to_owned())]);
+        assert!(!external_request_conflicts(&seen, "request-1", "same-payload"));
+        assert!(external_request_conflicts(&seen, "request-1", "changed-payload"));
+        assert!(!external_request_conflicts(&seen, "request-2", "new-payload"));
+    }
+
+    #[test]
+    fn pair_catalog_finds_loaded_talkers_after_the_first_twenty_four() {
+        let mut candidates = (0..27)
+            .map(|index| TalkCatalogCandidate {
+                position: [index as f32 * 100.0, 0.0],
+                loaded: false,
+                talkable: false,
+            })
+            .collect::<Vec<_>>();
+        candidates[25] = TalkCatalogCandidate {
+            position: [0.0, 0.0],
+            loaded: true,
+            talkable: true,
+        };
+        candidates[26] = TalkCatalogCandidate {
+            position: [1.0, 0.0],
+            loaded: true,
+            talkable: true,
+        };
+
+        let (loaded, simulated) = select_nearby_talk_pairs(&candidates);
+        assert_eq!(loaded, vec![(25, 26, 1.0)]);
+        assert!(simulated.is_empty());
+    }
+
+    #[test]
+    fn simulated_neighbors_are_hints_not_loaded_talk_pairs() {
+        let candidates = [
+            TalkCatalogCandidate { position: [0.0, 0.0], loaded: false, talkable: false },
+            TalkCatalogCandidate { position: [2.0, 0.0], loaded: false, talkable: false },
+        ];
+        let (loaded, simulated) = select_nearby_talk_pairs(&candidates);
+        assert!(loaded.is_empty());
+        assert_eq!(simulated, vec![(0, 1, 2.0)]);
+    }
+
+    #[test]
+    fn native_terminal_event_is_bookkept_once_per_request_id() {
+        let mut terminal = HashSet::new();
+        assert!(mark_external_terminal(&mut terminal, "request-1"));
+        assert!(!mark_external_terminal(&mut terminal, "request-1"));
+    }
+}
