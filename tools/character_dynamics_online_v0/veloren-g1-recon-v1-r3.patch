+fn g1_hold_should_repath(
+    now: f64,
+    expires_at: f64,
+    distance_from_marker: f32,
+    arrival_radius: f32,
+) -> bool {
+    now >= expires_at || distance_from_marker > arrival_radius
+}
+
+/// Run G1 survey/rally navigation through the existing Brain goto primitives.
+/// Delivery intentionally uses the adjacent native external-talk lease below;
+/// the server settles it only after a provenance-matched native Say handoff.
+fn g1_recon_action<S: State>(ctx: &mut NpcCtx) -> Option<Box<dyn Action<S, ()>>> {
+    let lease = ctx.controller.g1_recon.clone()?;
+    if !matches!(lease.action, G1ReconAction::SurveyMarker | G1ReconAction::RallyMarker) {
+        return None;
+    }
+    let marker = ctx.data.g1_recon.markers.iter()
+        .find(|marker| marker.marker_id == lease.marker_id)?;
+    let position = vek::Vec2::new(marker.wpos[0], marker.wpos[1]);
+    let radius = marker.arrival_radius;
+    let request_id = lease.request_id;
+    let hold_request_id = request_id.clone();
+    let expires_at = lease.expires_at;
+    let hold_expires_at = expires_at.0;
+    let hold_position = position;
+    let hold_radius = radius;
+    Some(
+        movement::goto_2d(position, 1.0, radius)
+            .then(idle().repeat().stop_if(move |ctx: &mut NpcCtx| {
+                let lease_matches = ctx.controller.g1_recon.as_ref()
+                    .is_some_and(|active| active.request_id == hold_request_id);
+                !lease_matches || g1_hold_should_repath(
+                    ctx.time.0,
+                    hold_expires_at,
+                    ctx.npc.wpos.xy().distance(hold_position),
+                    hold_radius,
+                )
+            }))
+            .map(|_, _| ())
+            // Re-enter native navigation after the hold drifts outside the
+            // settlement radius. This also resumes the goto/hold cycle after
+            // a native interruption without pinning or writing coordinates.
+            .repeat()
+            // Guard the complete navigation action too: if the lease is
+            // cancelled or expires while goto_2d is running, movement must
+            // stop rather than merely preventing the subsequent idle loop.
+            .stop_if(move |ctx: &mut NpcCtx| {
+                ctx.controller.g1_recon.as_ref().is_none_or(|active| {
+                    active.request_id != request_id || ctx.time.0 >= expires_at.0
+                })
+            })
+            .map(|_, _| ())
+            .boxed(),
+    )
+}
