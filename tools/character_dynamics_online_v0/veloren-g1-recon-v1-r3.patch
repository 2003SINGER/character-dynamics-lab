diff --git a/server/src/rtsim/g1_recon.rs b/server/src/rtsim/g1_recon.rs
new file mode 100644
index 0000000..87d9530
--- /dev/null
+++ b/server/src/rtsim/g1_recon.rs
@@ -0,0 +1,677 @@
+use super::RtSim;
+use common::{resources::Time, rtsim::Actor};
+use rtsim::data::{
+    G1DeliveryFact, G1Marker, G1ReconState, G1Report,
+    npc::{ExternalTalkLease, G1ReconAction, G1ReconLease, Job, NpcId, SimulationMode},
+};
+use serde_json::{Value, json};
+use std::{
+    collections::HashMap,
+    fs::File,
+    io::{Read, Seek, SeekFrom, Write},
+    time::Instant,
+};
+
+const RULE_VERSION: &str = "recon-v1";
+const VIEW_INTERVAL: std::time::Duration = std::time::Duration::from_secs(1);
+const MAX_REQUEST_BYTES: usize = 1_000_000;
+const MAX_EVENT_BYTES: usize = 64 * 1024;
+const MAX_TTL: f64 = 120.0;
+const MAX_CLOCK_AGE: f64 = 10.0;
+const NEARBY_RADIUS: f32 = 24.0;
+const REPORT_DISTANCE: f32 = 8.0;
+
+fn emit(rtsim: &RtSim, value: Value) {
+    let Some(path) = &rtsim.g1_events_path else { return };
+    let Ok(mut row) = serde_json::to_vec(&value) else { return };
+    row.push(b'\n');
+    if row.len() > MAX_EVENT_BYTES { return }
+    if let Ok(mut file) = File::options().create(true).append(true).open(path) {
+        let _ = file.write_all(&row);
+    }
+}
+
+pub(super) fn emit_native_speech(
+    rtsim: &RtSim,
+    request_id: &str,
+    actor_uid: u64,
+    recipient_uid: u64,
+    game_time: f64,
+) {
+    emit(rtsim, json!({
+        "event":"g1_native_speech_emitted", "schema_version":1,
+        "rule_version":RULE_VERSION, "request_id":request_id,
+        "actor_uid":actor_uid, "recipient_uid":recipient_uid,
+        "native_action":"Say", "game_time":game_time,
+        "evidence":"allowed_to_speak_and_chat_npc_emitted",
+    }));
+}
+
+fn reject(rtsim: &RtSim, request_id: Option<&str>, actor_uid: Option<u64>, reason: &str, time: f64) {
+    emit(rtsim, json!({
+        "event":"g1_action_rejected", "schema_version":1,
+        "rule_version":RULE_VERSION, "request_id":request_id,
+        "actor_uid":actor_uid, "reason":reason, "game_time":time,
+    }));
+}
+
+fn init_markers(data: &mut rtsim::data::Data, anchor_uid: u64) -> Result<(), &'static str> {
+    if !data.g1_recon.markers.is_empty() {
+        return if data.g1_recon.rule_version == RULE_VERSION {
+            Ok(())
+        } else {
+            Err("g1_rule_version_mismatch")
+        };
+    }
+    let anchor = data.npcs.values().find(|npc| npc.uid == anchor_uid)
+        .and_then(|npc| npc.home.into_iter().chain(npc.current_site).find_map(|site_id| data.sites.get(site_id)))
+        .map(|site| site.wpos);
+    let Some(anchor) = anchor else { return Err("actor_has_no_real_home_or_current_site") };
+    let base = [anchor.x as f32, anchor.y as f32];
+    // Versioned G1 map labels around an existing native camp; no site, terrain,
+    // NPC, or navigation data is created or modified.
+    data.g1_recon = G1ReconState {
+        rule_version: RULE_VERSION.to_owned(),
+        markers: vec![
+            G1Marker {
+                marker_id: "recon_site_a".to_owned(),
+                label: "G1 Recon Camp A".to_owned(),
+                kind: "survey_and_rally".to_owned(),
+                wpos: [base[0] + 24.0, base[1]],
+                arrival_radius: 4.0,
+                follower_radius: 10.0,
+                survey_seconds: 2.0,
+            },
+            G1Marker {
+                marker_id: "recon_site_b".to_owned(),
+                label: "G1 Recon Camp B".to_owned(),
+                kind: "survey_and_rally".to_owned(),
+                wpos: [base[0], base[1] + 24.0],
+                arrival_radius: 4.0,
+                follower_radius: 10.0,
+                survey_seconds: 2.0,
+            },
+        ],
+        ..Default::default()
+    };
+    Ok(())
+}
+
+fn marker(state: &G1ReconState, id: &str) -> Option<G1Marker> {
+    state.markers.iter().find(|marker| marker.marker_id == id).cloned()
+}
+
+fn has_capability(marker: &G1Marker, capability: &str) -> bool {
+    marker.kind.split('_').any(|item| item == capability)
+}
+
+fn job_label(job: &Option<Job>) -> &'static str {
+    match job {
+        Some(Job::Hired(_, _)) => "Hired",
+        Some(Job::Quest(_)) => "Quest",
+        None => "None",
+    }
+}
+
+fn survey_settled_at(started_at: &mut Option<f64>, in_radius: bool, now: f64, required: f64) -> Option<f64> {
+    if !in_radius {
+        *started_at = None;
+        return None;
+    }
+    let started = *started_at.get_or_insert(now);
+    (now - started >= required).then_some(started)
+}
+
+fn lease_expired(now: f64, expires_at: f64) -> bool {
+    now >= expires_at
+}
+
+fn npc_id_by_uid(data: &rtsim::data::Data, uid: u64) -> Option<NpcId> {
+    data.npcs.iter().find_map(|(id, npc)| (npc.uid == uid).then_some(id))
+}
+
+fn request_key<'a>(value: &'a Value, key: &str) -> Option<&'a str> {
+    value.get(key).and_then(Value::as_str).filter(|s| !s.is_empty() && s.len() <= 128)
+}
+
+fn process_row(rtsim: &mut RtSim, value: Value, now: Time) {
+    let request_id = request_key(&value, "request_id");
+    let actor_uid = value.get("actor_uid").and_then(Value::as_u64);
+    let Some(request_id) = request_id else {
+        reject(rtsim, None, actor_uid, "missing_or_invalid_request_id", now.0);
+        return;
+    };
+    let Some(actor_uid) = actor_uid.filter(|uid| rtsim.g1_actor_uids.contains(uid)) else {
+        reject(rtsim, Some(request_id), actor_uid, "actor_uid_not_allowlisted", now.0);
+        return;
+    };
+    let source = request_key(&value, "source").unwrap_or("");
+    if !matches!(source, "ACTOR" | "AUTHOR" | "DIRECTOR") {
+        reject(rtsim, Some(request_id), Some(actor_uid), "invalid_source", now.0);
+        return;
+    }
+    let observed_time = value.get("observed_time").and_then(Value::as_f64).unwrap_or(f64::NAN);
+    if !observed_time.is_finite() || observed_time > now.0 || now.0 - observed_time > MAX_CLOCK_AGE {
+        reject(rtsim, Some(request_id), Some(actor_uid), "stale_or_future_observed_time", now.0);
+        return;
+    }
+    let rule_version = request_key(&value, "rule_version").unwrap_or("");
+    if rule_version != RULE_VERSION {
+        reject(rtsim, Some(request_id), Some(actor_uid), "g1_rule_version_mismatch", now.0);
+        return;
+    }
+    let ttl = value.get("ttl_seconds").and_then(Value::as_f64).unwrap_or(f64::NAN);
+    if !ttl.is_finite() || !(0.1..=MAX_TTL).contains(&ttl) {
+        reject(rtsim, Some(request_id), Some(actor_uid), "invalid_ttl", now.0);
+        return;
+    }
+    let action = match value.get("action").and_then(Value::as_str) {
+        Some("survey_marker") => G1ReconAction::SurveyMarker,
+        Some("deliver_report") => G1ReconAction::DeliverReport,
+        Some("rally_marker") => G1ReconAction::RallyMarker,
+        _ => {
+            reject(rtsim, Some(request_id), Some(actor_uid), "unsupported_action", now.0);
+            return;
+        },
+    };
+    let args = value.get("args").cloned().unwrap_or(Value::Null);
+    let marker_id = args.get("marker_id").and_then(Value::as_str).unwrap_or("");
+    if marker_id.is_empty() || marker_id.len() > 128 {
+        reject(rtsim, Some(request_id), Some(actor_uid), "invalid_marker_id", now.0);
+        return;
+    }
+    let report_hint = args.get("report_id").and_then(Value::as_str).map(str::to_owned);
+    let receiver_uid = args.get("receiver_uid").and_then(Value::as_u64);
+    let follower_uid = args.get("follower_uid").and_then(Value::as_u64);
+    let goal_id = value.get("goal_id").and_then(Value::as_str).map(str::to_owned);
+    let node_id = request_key(&value, "node_id").unwrap_or("").to_owned();
+    if node_id.is_empty() {
+        reject(rtsim, Some(request_id), Some(actor_uid), "missing_node_id", now.0);
+        return;
+    }
+    let author_version = value.get("author_version").and_then(Value::as_u64).and_then(|v| u32::try_from(v).ok());
+    if source != "ACTOR" && author_version.is_none() {
+        reject(rtsim, Some(request_id), Some(actor_uid), "author_version_required", now.0);
+        return;
+    }
+    let canonical = value.to_string();
+    if let Some(previous) = rtsim.seen_g1_requests.get(request_id) {
+        if previous != &canonical {
+            reject(rtsim, Some(request_id), Some(actor_uid), "request_id_conflict", now.0);
+        }
+        return;
+    }
+    if rtsim.seen_g1_requests.len() >= 4096 {
+        reject(rtsim, Some(request_id), Some(actor_uid), "request_capacity_reached", now.0);
+        return;
+    }
+    rtsim.seen_g1_requests.insert(request_id.to_owned(), canonical);
+
+    let mut data = rtsim.state.data_mut();
+    let anchor_uid = if rtsim.g1_actor_uids.contains(&476) { 476 } else { actor_uid };
+    if let Err(reason) = init_markers(&mut data, anchor_uid) {
+        drop(data);
+        reject(rtsim, Some(request_id), Some(actor_uid), reason, now.0);
+        return;
+    }
+    let Some(actor_id) = npc_id_by_uid(&data, actor_uid) else {
+        drop(data);
+        reject(rtsim, Some(request_id), Some(actor_uid), "actor_not_found", now.0);
+        return;
+    };
+    if !matches!(data.npcs[actor_id].mode, SimulationMode::Loaded) {
+        drop(data);
+        reject(rtsim, Some(request_id), Some(actor_uid), "actor_not_loaded", now.0);
+        return;
+    }
+    let Some(target_marker) = marker(&data.g1_recon, marker_id) else {
+        drop(data);
+        reject(rtsim, Some(request_id), Some(actor_uid), "unknown_g1_marker", now.0);
+        return;
+    };
+    if data.npcs[actor_id].is_dead() || data.npcs[actor_id].controller.g1_recon.is_some() {
+        drop(data);
+        reject(rtsim, Some(request_id), Some(actor_uid), "actor_dead_or_has_active_g1_lease", now.0);
+        return;
+    }
+    let source_npc = &data.npcs[actor_id];
+    let mut resolved_follower_uid = follower_uid;
+    let report = match action {
+        G1ReconAction::SurveyMarker => {
+            if !has_capability(&target_marker, "survey") {
+                drop(data);
+                reject(rtsim, Some(request_id), Some(actor_uid), "marker_not_survey_site", now.0);
+                return;
+            }
+            if data.g1_recon.reports.values().any(|r| r.owner_uid == actor_uid && r.marker_id == marker_id) {
+                drop(data);
+                reject(rtsim, Some(request_id), Some(actor_uid), "survey_already_recorded", now.0);
+                return;
+            }
+            None
+        },
+        G1ReconAction::DeliverReport => {
+            let Some(receiver_uid) = receiver_uid else {
+                drop(data);
+                reject(rtsim, Some(request_id), Some(actor_uid), "receiver_uid_required", now.0);
+                return;
+            };
+            let Some(report) = data.g1_recon.reports.values().find(|r| {
+                r.owner_uid == actor_uid && r.marker_id == marker_id
+                    && report_hint.as_ref().is_none_or(|hint| hint == &r.report_id)
+            }).cloned() else {
+                drop(data);
+                reject(rtsim, Some(request_id), Some(actor_uid), "no_matching_owned_report", now.0);
+                return;
+            };
+            let Some(receiver_id) = npc_id_by_uid(&data, receiver_uid) else {
+                drop(data);
+                reject(rtsim, Some(request_id), Some(actor_uid), "receiver_not_found", now.0);
+                return;
+            };
+            let receiver = &data.npcs[receiver_id];
+            let dist = receiver.wpos.xy().distance(source_npc.wpos.xy());
+            if receiver_id == actor_id || receiver.is_dead() || dist > NEARBY_RADIUS
+                || !matches!(source_npc.mode, SimulationMode::Loaded)
+                || !matches!(receiver.mode, SimulationMode::Loaded)
+                || source_npc.controller.external_talk.is_some()
+                || receiver.controller.external_talk.is_some()
+                || receiver.controller.g1_recon.is_some()
+            {
+                drop(data);
+                reject(rtsim, Some(request_id), Some(actor_uid), "receiver_not_live_loaded_nearby_or_available", now.0);
+                return;
+            }
+            Some(report)
+        },
+        G1ReconAction::RallyMarker => {
+            if !has_capability(&target_marker, "rally") {
+                drop(data);
+                reject(rtsim, Some(request_id), Some(actor_uid), "marker_not_rally_site", now.0);
+                return;
+            }
+            let known = data.g1_recon.known_reports.get(&actor_uid);
+            let report = data.g1_recon.reports.values().find(|r| {
+                r.marker_id == marker_id
+                    && r.owner_uid != actor_uid
+                    && known.is_some_and(|set| set.contains(&r.report_id))
+                    && report_hint.as_ref().is_none_or(|hint| hint == &r.report_id)
+            }).cloned();
+            let Some(report) = report else {
+                drop(data);
+                reject(rtsim, Some(request_id), Some(actor_uid), "leader_does_not_know_matching_report", now.0);
+                return;
+            };
+            let hired_follower = data.npcs.iter().find(|(_, npc)| {
+                follower_uid.is_none_or(|uid| npc.uid == uid)
+                    && matches!(npc.job, Some(Job::Hired(Actor::Npc(hirer), _)) if hirer == actor_id)
+            });
+            if let Some((_, follower)) = hired_follower {
+                resolved_follower_uid = Some(follower.uid);
+            } else {
+                drop(data);
+                reject(rtsim, Some(request_id), Some(actor_uid), "no_native_hired_follower", now.0);
+                return;
+            }
+            Some(report)
+        },
+    };
+    let resolved_report_id = report.as_ref().map(|r| r.report_id.clone());
+    if matches!(action, G1ReconAction::DeliverReport)
+        && data.npcs[actor_id].controller.external_talk.is_some()
+    {
+        drop(data);
+        reject(rtsim, Some(request_id), Some(actor_uid), "actor_has_native_talk_lease", now.0);
+        return;
+    }
+    let expiry = Time(now.0 + ttl);
+    data.npcs[actor_id].controller.g1_recon = Some(G1ReconLease {
+        request_id: request_id.to_owned(),
+        rule_version: RULE_VERSION.to_owned(),
+        action: action.clone(),
+        actor_uid,
+        node_id: node_id.clone(),
+        source: source.to_owned(),
+        goal_id: goal_id.clone(),
+        author_version,
+        marker_id: marker_id.to_owned(),
+        report_id: resolved_report_id.clone(),
+        receiver_uid,
+        follower_uid: resolved_follower_uid,
+        expires_at: expiry,
+        survey_started_at: None,
+        say_emitted_at: None,
+        say_recipient_uid: None,
+    });
+    if let Some(report) = report.filter(|_| matches!(action, G1ReconAction::DeliverReport)) {
+        let target = npc_id_by_uid(&data, receiver_uid.unwrap()).expect("validated receiver");
+        data.npcs[actor_id].controller.external_talk = Some(ExternalTalkLease {
+            request_id: request_id.to_owned(),
+            target: Actor::Npc(target),
+            expires_at: expiry,
+            cancelled: false,
+            started: false,
+            outcome: None,
+            branch_route: None,
+            smalltalk_early_cut: None,
+            branch_reported: false,
+        });
+        let _ = report;
+    }
+    drop(data);
+    emit(rtsim, json!({
+        "event":"g1_action_accepted", "schema_version":1,
+        "rule_version":RULE_VERSION, "request_id":request_id,
+        "actor_uid":actor_uid, "node_id":node_id,
+        "source":source, "goal_id":goal_id,
+        "author_version":author_version,
+        "action":value.get("action"), "args":args, "game_time":now.0,
+    }));
+}
+
+pub(super) fn process_requests(rtsim: &mut RtSim, now: Time) {
+    let Some(path) = rtsim.g1_request_path.clone() else { return };
+    let Ok(mut file) = File::open(path) else { return };
+    let Ok(file_len) = file.metadata().map(|metadata| metadata.len()) else { return };
+    if file_len < rtsim.g1_request_offset { rtsim.g1_request_offset = 0; }
+    if file.seek(SeekFrom::Start(rtsim.g1_request_offset)).is_err() { return }
+    let mut bytes = Vec::new();
+    if file.take((MAX_REQUEST_BYTES + 1) as u64).read_to_end(&mut bytes).is_err() { return }
+    if bytes.len() > MAX_REQUEST_BYTES {
+        reject(rtsim, None, None, "request_file_over_1MiB", now.0);
+        rtsim.g1_request_offset = file_len;
+        return;
+    }
+    let contents = String::from_utf8_lossy(&bytes);
+    let Some(complete_end) = contents.rfind('\n').map(|index| index + 1) else { return };
+    rtsim.g1_request_offset += complete_end as u64;
+    for line in contents[..complete_end].lines().filter(|line| !line.trim().is_empty()) {
+        match serde_json::from_str::<Value>(line) {
+            Ok(value) => process_row(rtsim, value, now),
+            Err(_) => reject(rtsim, None, None, "invalid_jsonl", now.0),
+        }
+    }
+}
+
+fn emit_terminal(rtsim: &RtSim, lease: &G1ReconLease, time: f64, event: &str, reason: Option<&str>, effects: Vec<Value>) {
+    emit(rtsim, json!({
+        "event":event, "schema_version":1, "rule_version":lease.rule_version,
+        "request_id":lease.request_id, "actor_uid":lease.actor_uid,
+        "node_id":lease.node_id, "source":lease.source,
+        "goal_id":lease.goal_id, "author_version":lease.author_version,
+        "action":match lease.action {
+            G1ReconAction::SurveyMarker => "survey_marker",
+            G1ReconAction::DeliverReport => "deliver_report",
+            G1ReconAction::RallyMarker => "rally_marker",
+        },
+        "args":{"marker_id":lease.marker_id,"report_id":lease.report_id,
+            "receiver_uid":lease.receiver_uid,"follower_uid":lease.follower_uid},
+        "game_time":time, "reason":reason, "effects":effects,
+    }));
+}
+
+pub(super) fn after_tick(rtsim: &mut RtSim, now: Time) {
+    let mut data = rtsim.state.data_mut();
+    let mut settled = Vec::new();
+    let mut failed = Vec::new();
+    let markers = data.g1_recon.markers.clone();
+    let reports = data.g1_recon.reports.clone();
+    let known_reports = data.g1_recon.known_reports.clone();
+    let people = data.npcs.iter().map(|(id, npc)| {
+        (npc.uid, (id, npc.wpos, !npc.is_dead(), matches!(npc.mode, SimulationMode::Loaded), npc.job.clone()))
+    }).collect::<HashMap<_, _>>();
+    let mut new_reports = Vec::new();
+    let mut new_deliveries = Vec::new();
+    let mut new_rallies = Vec::new();
+    for (actor_id, actor) in data.npcs.iter_mut() {
+        let actor_dead = actor.is_dead();
+        let actor_loaded = matches!(actor.mode, SimulationMode::Loaded);
+        let Some(lease) = actor.controller.g1_recon.as_mut() else { continue };
+        let Some(site) = markers.iter().find(|marker| marker.marker_id == lease.marker_id).cloned() else {
+            failed.push((actor_id, lease.clone(), "marker_unavailable".to_owned()));
+            continue;
+        };
+        if lease_expired(now.0, lease.expires_at.0) {
+            failed.push((actor_id, lease.clone(), "ttl_expired".to_owned()));
+            continue;
+        }
+        if actor_dead {
+            failed.push((actor_id, lease.clone(), "actor_dead".to_owned()));
+            continue;
+        }
+        if !actor_loaded {
+            failed.push((actor_id, lease.clone(), "actor_not_loaded".to_owned()));
+            continue;
+        }
+        match lease.action {
+            G1ReconAction::SurveyMarker => {
+                let distance = actor.wpos.xy().distance(vek::Vec2::new(site.wpos[0], site.wpos[1]));
+                if let Some(started) = survey_settled_at(
+                    &mut lease.survey_started_at,
+                    distance <= site.arrival_radius,
+                    now.0,
+                    site.survey_seconds,
+                ) {
+                        let report_id = format!("g1:{}:{}", lease.marker_id, lease.actor_uid);
+                        let report = G1Report {
+                            report_id: report_id.clone(), marker_id: lease.marker_id.clone(),
+                            owner_uid: lease.actor_uid, surveyed_at: now.0,
+                        };
+                        new_reports.push(report);
+                        let effect = json!({"event":"g1_survey_completed","report_id":report_id,
+                            "marker_id":lease.marker_id,"actual_wpos":[actor.wpos.x,actor.wpos.y,actor.wpos.z],
+                            "marker_wpos":site.wpos,"arrival_radius":site.arrival_radius,
+                            "continuous_stay_seconds":now.0-started,"started_at":started,"settled_at":now.0});
+                        settled.push((actor_id, lease.clone(), effect));
+                }
+            },
+            G1ReconAction::DeliverReport => {
+                if lease.say_emitted_at.is_none()
+                    || lease.say_recipient_uid != lease.receiver_uid
+                {
+                    let outcome = actor.controller.external_talk.as_ref()
+                        .filter(|talk| talk.request_id == lease.request_id)
+                        .and_then(|talk| talk.outcome);
+                    if let Some(outcome) = outcome.filter(|outcome| *outcome != "native_intent_queued") {
+                        failed.push((actor_id, lease.clone(), outcome.to_owned()));
+                    }
+                    continue;
+                }
+                let Some(receiver_uid) = lease.receiver_uid else {
+                    failed.push((actor_id, lease.clone(), "receiver_uid_missing".to_owned()));
+                    continue;
+                };
+                let Some((_, receiver_wpos, receiver_alive, receiver_loaded, _)) = people.get(&receiver_uid) else {
+                    failed.push((actor_id, lease.clone(), "receiver_disappeared".to_owned()));
+                    continue;
+                };
+                if !receiver_alive || !receiver_loaded {
+                    failed.push((actor_id, lease.clone(), "receiver_dead".to_owned()));
+                    continue;
+                }
+                let distance = actor.wpos.xy().distance(receiver_wpos.xy());
+                let report_id = lease.report_id.clone().unwrap_or_default();
+                if distance > REPORT_DISTANCE || report_id.is_empty()
+                    || !reports.get(&report_id).is_some_and(|report| report.owner_uid == lease.actor_uid)
+                {
+                    failed.push((actor_id, lease.clone(), "native_say_handoff_without_valid_nearby_report".to_owned()));
+                    continue;
+                }
+                new_deliveries.push(G1DeliveryFact {
+                    marker_id: lease.marker_id.clone(),
+                    report_id: report_id.clone(),
+                    from_uid: lease.actor_uid,
+                    to_uid: receiver_uid,
+                    delivered_at: now.0,
+                });
+                let effect = json!({"event":"g1_report_delivered","report_id":report_id,
+                    "from_uid":lease.actor_uid,"to_uid":receiver_uid,
+                    "actual_wpos":[actor.wpos.x,actor.wpos.y,actor.wpos.z],"distance":distance,
+                    "native_interaction":"native_speech_emitted","interaction_request_id":lease.request_id,
+                    "speech_emitted_at":lease.say_emitted_at,
+                    "settled_at":now.0});
+                settled.push((actor_id, lease.clone(), effect));
+            },
+            G1ReconAction::RallyMarker => {
+                let Some(report_id) = lease.report_id.as_ref() else { continue };
+                if !known_reports.get(&lease.actor_uid).is_some_and(|known| known.contains(report_id)) {
+                    failed.push((actor_id, lease.clone(), "leader_no_longer_knows_report".to_owned()));
+                    continue;
+                }
+                let follower = people.iter().find(|(uid, (_, _, alive, loaded, job))| {
+                    *alive && *loaded
+                        && lease.follower_uid.is_none_or(|required| required == **uid)
+                        && matches!(job, Some(Job::Hired(Actor::Npc(hirer), _)) if *hirer == actor_id)
+                });
+                let Some((follower_uid, (_, follower_wpos, _, _, _))) = follower else { continue; };
+                let leader_dist = actor.wpos.xy().distance(vek::Vec2::new(site.wpos[0], site.wpos[1]));
+                let follower_dist = follower_wpos.xy().distance(vek::Vec2::new(site.wpos[0], site.wpos[1]));
+                if leader_dist <= site.arrival_radius && follower_dist <= site.follower_radius {
+                    new_rallies.push(rtsim::data::G1RallyFact {
+                        marker_id: lease.marker_id.clone(), leader_uid: lease.actor_uid,
+                        follower_uid: *follower_uid, report_id: report_id.clone(), settled_at: now.0,
+                    });
+                    let effect = json!({"event":"g1_rally_completed","marker_id":lease.marker_id,
+                        "report_id":report_id,"report_owner_uid":reports.get(report_id).map(|report| report.owner_uid),
+                        "from_uid":reports.get(report_id).map(|report| report.owner_uid),
+                        "follower_uid":*follower_uid,"leader_uid":lease.actor_uid,
+                        "leader_wpos":[actor.wpos.x,actor.wpos.y,actor.wpos.z],
+                        "follower_wpos":[follower_wpos.x,follower_wpos.y,follower_wpos.z],
+                        "leader_radius":site.arrival_radius,"follower_radius":site.follower_radius,
+                        "leader_hired_follower":true,
+                        "leader_knows_report":true,"settled_at":now.0});
+                    settled.push((actor_id, lease.clone(), effect));
+                }
+            },
+        }
+    }
+    for report in new_reports {
+        data.g1_recon.known_reports.entry(report.owner_uid).or_default().insert(report.report_id.clone());
+        data.g1_recon.reports.insert(report.report_id.clone(), report);
+    }
+    for delivery in new_deliveries {
+        data.g1_recon.known_reports.entry(delivery.to_uid).or_default().insert(delivery.report_id.clone());
+        data.g1_recon.completed_deliveries.push(delivery);
+    }
+    data.g1_recon.completed_rallies.extend(new_rallies);
+    for (id, lease, effect) in settled {
+        emit_terminal(rtsim, &lease, now.0, "g1_action_settled", None, vec![effect]);
+        data.npcs[id].controller.g1_recon = None;
+        if data.npcs[id].controller.external_talk.as_ref().is_some_and(|talk| talk.request_id == lease.request_id) {
+            data.npcs[id].controller.external_talk = None;
+        }
+    }
+    for (id, lease, reason) in failed {
+        emit_terminal(rtsim, &lease, now.0, "g1_action_failed", Some(&reason), Vec::new());
+        data.npcs[id].controller.g1_recon = None;
+        if data.npcs[id].controller.external_talk.as_ref().is_some_and(|talk| talk.request_id == lease.request_id) {
+            data.npcs[id].controller.external_talk = None;
+        }
+    }
+}
+
+fn view(rtsim: &RtSim, actor_uid: u64, time: Time) -> Option<Value> {
+    let data = rtsim.state.data();
+    let (_, actor) = data.npcs.iter().find(|(_, npc)| npc.uid == actor_uid)?;
+    let markers = &data.g1_recon.markers;
+    let own_reports = data.g1_recon.reports.values()
+        .filter(|r| r.owner_uid == actor_uid)
+        .cloned().collect::<Vec<_>>();
+    let known_ids = data.g1_recon.known_reports.get(&actor_uid);
+    let known_reports = data.g1_recon.reports.values()
+        .filter(|r| known_ids.is_some_and(|ids| ids.contains(&r.report_id)))
+        .cloned().collect::<Vec<_>>();
+    let own_report_deliveries = data.g1_recon.completed_deliveries.iter()
+        .filter(|delivery| delivery.from_uid == actor_uid || delivery.to_uid == actor_uid)
+        .cloned().collect::<Vec<_>>();
+    let completed_rallies = data.g1_recon.completed_rallies.iter()
+        .filter(|rally| rally.leader_uid == actor_uid)
+        .cloned().collect::<Vec<_>>();
+    let nearby = data.npcs.values().filter_map(|npc| {
+        let distance = npc.wpos.xy().distance(actor.wpos.xy());
+        (npc.uid != actor_uid && distance <= NEARBY_RADIUS).then(|| json!({
+            "uid":npc.uid,"wpos":[npc.wpos.x,npc.wpos.y,npc.wpos.z],"distance":distance,
+            "alive":!npc.is_dead(),"loaded":matches!(npc.mode,SimulationMode::Loaded),
+            "hired_by_uid":match npc.job { Some(Job::Hired(Actor::Npc(hirer),_)) => data.npcs.get(hirer).map(|n|n.uid), _ => None },
+        }))
+    }).collect::<Vec<_>>();
+    Some(json!({
+        "event":"g1_actor_view","schema_version":1,"rule_version":RULE_VERSION,
+        "time":time.0,"actor_uid":actor_uid,"wpos":[actor.wpos.x,actor.wpos.y,actor.wpos.z],
+        "role":format!("{:?}",actor.role),"job":job_label(&actor.job),
+        "mode":if matches!(actor.mode,SimulationMode::Loaded){"loaded"}else{"simulated"},
+        "current_site":actor.current_site.map(|site|format!("{:?}",site)),
+        "home_site":actor.home.map(|site|format!("{:?}",site)),
+        "markers":markers,"own_reports":own_reports,"known_reports":known_reports,
+        "own_report_deliveries":own_report_deliveries,"completed_rallies":completed_rallies,
+        "nearby":nearby,
+        "active_lease":actor.controller.g1_recon.as_ref().map(|lease|json!({
+            "request_id":lease.request_id,"action":format!("{:?}",lease.action),
+            "node_id":lease.node_id,"marker_id":lease.marker_id,"expires_at":lease.expires_at.0,
+        })),
+    }))
+}
+
+pub(super) fn observe(rtsim: &mut RtSim, time: Time) {
+    if rtsim.g1_events_path.is_none() || rtsim.g1_actor_uids.is_empty() { return }
+    if rtsim.last_g1_observation.is_some_and(|last| last.elapsed() < VIEW_INTERVAL) { return }
+    rtsim.last_g1_observation = Some(Instant::now());
+    if rtsim.state.data().g1_recon.markers.is_empty() {
+        let anchor_uid = if rtsim.g1_actor_uids.contains(&476) { 476 }
+            else { rtsim.g1_actor_uids.iter().copied().min().unwrap_or_default() };
+        let mut data = rtsim.state.data_mut();
+        let _ = init_markers(&mut data, anchor_uid);
+    }
+    let mut events = Vec::new();
+    for actor_uid in rtsim.g1_actor_uids.iter().copied() {
+        if let Some(row) = view(rtsim, actor_uid, time) { events.push(row); }
+    }
+    for event in events { emit(rtsim, event); }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{has_capability, lease_expired, survey_settled_at};
+    use rtsim::data::G1Marker;
+
+    fn marker(kind: &str) -> G1Marker {
+        G1Marker {
+            marker_id: "test".to_owned(),
+            label: "test marker".to_owned(),
+            kind: kind.to_owned(),
+            wpos: [0.0, 0.0],
+            arrival_radius: 4.0,
+            follower_radius: 10.0,
+            survey_seconds: 2.0,
+        }
+    }
+
+    #[test]
+    fn recon_sites_support_survey_and_rally_without_a_hardcoded_sequence() {
+        let site_a = marker("survey_and_rally");
+        let site_b = marker("survey_and_rally");
+        assert!(has_capability(&site_a, "survey"));
+        assert!(has_capability(&site_a, "rally"));
+        assert!(has_capability(&site_b, "survey"));
+        assert!(has_capability(&site_b, "rally"));
+        assert!(!has_capability(&site_a, "survey_and_rally"));
+    }
+
+    #[test]
+    fn survey_requires_continuous_presence_and_restarts_after_interruption() {
+        let mut started = None;
+        assert_eq!(survey_settled_at(&mut started, true, 5.0, 2.0), None);
+        assert_eq!(survey_settled_at(&mut started, false, 6.0, 2.0), None);
+        assert_eq!(started, None);
+        assert_eq!(survey_settled_at(&mut started, true, 7.0, 2.0), None);
+        assert_eq!(survey_settled_at(&mut started, true, 8.99, 2.0), None);
+        assert_eq!(survey_settled_at(&mut started, true, 9.0, 2.0), Some(7.0));
+    }
+
+    #[test]
+    fn ttl_is_terminal_at_the_deadline() {
+        assert!(!lease_expired(9.99, 10.0));
+        assert!(lease_expired(10.0, 10.0));
+        assert!(lease_expired(10.01, 10.0));
+    }
+}
