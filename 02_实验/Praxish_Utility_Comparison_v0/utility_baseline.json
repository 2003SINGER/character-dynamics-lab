{
  "schema_version": 1,
  "authorship": "independently authored flat utility configuration; not translated from Praxish practice definitions",
  "roles": { "Worker": ["worker", "worker2"], "Visitor": ["visitor", "visitor2"] },
  "action_templates": [
    { "id": "start_restocking", "actor_role": "Worker", "roles": { "Worker": "actor" }, "practice_instance": "practice.restock.{Worker}", "preconditions": [{ "fact": ["work_phase", "{Worker}", "waiting"] }], "delete": [["work_phase", "{Worker}", "waiting"]], "insert": [["work_phase", "{Worker}", "working"]] },
    { "id": "finish_restocking", "actor_role": "Worker", "roles": { "Worker": "actor" }, "practice_instance": "practice.restock.{Worker}", "preconditions": [{ "fact": ["work_phase", "{Worker}", "working"] }], "delete": [["work_phase", "{Worker}", "working"]], "insert": [["work_phase", "{Worker}", "complete"]] },
    { "id": "answer_request", "actor_role": "Worker", "roles": { "Worker": "actor", "Visitor": "any" }, "practice_instance": "practice.request.{Worker}.{Visitor}", "preconditions": [{ "fact": ["request_status", "{Worker}", "{Visitor}", "pending"] }], "delete": [["request_status", "{Worker}", "{Visitor}", "pending"]], "insert": [["request_status", "{Worker}", "{Visitor}", "served"]] },
    { "id": "wait_for_answer", "actor_role": "Visitor", "roles": { "Visitor": "actor", "Worker": "any" }, "practice_instance": "practice.request.{Worker}.{Visitor}", "preconditions": [{ "fact": ["request_status", "{Worker}", "{Visitor}", "pending"] }], "delete": [], "insert": [] }
  ],
  "goal_factors": [
    { "id": "keep_working", "actor_role": "Worker", "weight": 1, "match": ["work_phase", "{actor}", "working"] },
    { "id": "finish_work", "actor_role": "Worker", "weight": 5, "match": ["work_phase", "{actor}", "complete"] },
    { "id": "serve_visitor", "actor_role": "Worker", "weight": 10, "match": ["request_status", "{actor}", "{Visitor}", "served"], "count_bindings": true }
  ],
  "extensions": {
    "cancel_request": { "action_templates": [{ "id": "cancel_request", "actor_role": "Visitor", "roles": { "Visitor": "actor", "Worker": "any" }, "practice_instance": "practice.request.{Worker}.{Visitor}", "preconditions": [{ "fact": ["request_status", "{Worker}", "{Visitor}", "pending"] }], "delete": [["request_status", "{Worker}", "{Visitor}", "pending"]], "insert": [["request_status", "{Worker}", "{Visitor}", "cancelled"]] }], "goal_factors": [{ "id": "cancel_request", "actor_role": "Visitor", "weight": 1, "match": ["request_status", "{Worker}", "{actor}", "cancelled"], "count_bindings": true }] },
    "workspace_filter": { "precondition": { "fact": ["workspace_open", "true"] } }
  }
}
