+fn pirate_recruit_prefix(target: NpcId, request_id: Option<String>) -> impl Action<DefaultState> {
+    let request_id_for_stop = request_id.clone();
+    follow_actor(Actor::Npc(target), 5.0)
+        .stop_if(move |ctx: &mut NpcCtx| {
+            if let Some(request_id) = &request_id_for_stop
+                && (!native_recruit_is_valid(ctx, request_id, target)
+                    || ctx.controller.native_recruit.as_ref().is_some_and(|task| task.message_sent))
+            {
+                return true;
+            }
+            let Some(follow_npc) = ctx.data.npcs.get(target) else {
+                return true;
+            };
+            ctx.npc.wpos.distance_squared(follow_npc.wpos) < 6.0f32.powi(2)
+        })
+        .then(just(move |ctx, _| {
+            if let Some(request_id) = &request_id {
+                if !native_recruit_is_valid(ctx, request_id, target)
+                    || ctx.controller.native_recruit.as_ref().is_some_and(|task| task.message_sent)
+                {
+                    return;
+                }
+                if let Some(task) = &mut ctx.controller.native_recruit
+                    && task.request_id == *request_id
+                {
+                    task.message_sent = true;
+                }
+            }
+            ctx.controller.send_msg(target, NpcMsg::RequestHire);
+        }))
+        .debug(|| "inviting raid participant")
+}
