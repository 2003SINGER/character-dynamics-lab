+#[cfg(test)]
+mod tests {
+    use super::{hire_observation_outcome, validate_request_time};
+    use common::resources::Time;
+
+    #[test]
+    fn hired_without_request_message_is_unattributed() {
+        assert_eq!(
+            hire_observation_outcome(true, false),
+            Some("native_hire_observed_without_request_message")
+        );
+        assert_eq!(hire_observation_outcome(true, true), Some("hired_observed"));
+        assert_eq!(hire_observation_outcome(false, true), None);
+    }
+
+    #[test]
+    fn recruit_request_observation_must_be_fresh_and_ttl_bounded() {
+        assert!(validate_request_time(9.0, 60.0, Time(10.0)).is_ok());
+        assert_eq!(
+            validate_request_time(0.0, 60.0, Time(10.01)),
+            Err("stale_observation")
+        );
+        assert_eq!(
+            validate_request_time(9.0, 120.1, Time(10.0)),
+            Err("invalid_ttl")
+        );
+    }
+}

