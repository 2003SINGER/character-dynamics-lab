+fn native_recruit_is_valid(ctx: &NpcCtx, request_id: &str, target: NpcId) -> bool {
+    let Some(task) = ctx.controller.native_recruit.as_ref() else {
+        return false;
+    };
+    let Some(home) = ctx.npc.home else {
+        return false;
+    };
+    let Some(faction) = ctx.npc.faction else {
+        return false;
+    };
+    let Some(site) = ctx.data.sites.get(home) else {
+        return false;
+    };
+    let has_nearby_raid_site = site.nearby_sites_by_size.iter().any(|site_id| {
+        ctx.data.sites.get(*site_id).is_some_and(|nearby| {
+            nearby.wpos.as_::<f32>().distance_squared(ctx.npc.wpos.xy())
+                < 10_000.0f32.powi(2)
+        })
+    });
+    task.request_id == request_id
+        && task.target == target
+        && task.expires_at.0 > ctx.time.0
+        && !ctx.npc.is_dead()
+        && ctx.npc.job.is_none()
+        && ctx.npc.current_site == Some(home)
+        && matches!(ctx.npc.role, Role::Civilised(Some(Profession::Pirate(true))))
+        && has_nearby_raid_site
+        && site
+            .population
+            .iter()
+            .filter(|npc_id| {
+                ctx.data.npcs.get(**npc_id).is_some_and(|npc| {
+                    !npc.is_dead()
+                        && npc.current_site == Some(home)
+                        && npc.faction == Some(faction)
+                        && npc.job.is_none()
+                        && matches!(npc.role, Role::Civilised(Some(Profession::Pirate(false))))
+                })
+            })
+            .count()
+            > 3
+        && site.population.contains(&target)
+        && ctx.data.npcs.get(target).is_some_and(|npc| {
+            !npc.is_dead()
+                && npc.current_site == Some(home)
+                && npc.faction == Some(faction)
+                && npc.job.is_none()
+                && matches!(npc.role, Role::Civilised(Some(Profession::Pirate(false))))
+        })
+}
