+                matches!(&target.job, Some(Job::Hired(Actor::Npc(hirer), _)) if *hirer == ctx.npc_id)
+            })
     })
 }
 
+fn start_native_recruit(task: NativeRecruitTask) -> impl Action<DefaultState> {
+    now(move |ctx, _| {
+        if let Some(active) = &mut ctx.controller.native_recruit
+            && active.request_id == task.request_id
+            && !active.message_sent
+            && active.expires_at.0 > ctx.time.0
+        {
+            active.started = true;
+        }
+        pirate_recruit_prefix(task.target, Some(task.request_id.clone()))
+    })
+}
