+
+    fn provenance() -> NativeRecruitMessageProvenance {
+        NativeRecruitMessageProvenance {
+            request_id: "native-loaded-msg-test".into(),
+            source_uid: 476,
+            target_uid: 442,
+            decision_source: "test".into(),
+        }
+    }
+
+    #[test]
+    fn native_loaded_msg_is_collected_once_with_exact_provenance() {
+        let sender = NpcId::default();
+        let receiver = NpcId::default();
+        let expected = provenance();
+        let mut controller = Controller::default();
+        controller.send_msg_with_native_recruit_provenance(
+            Actor::Npc(receiver),
+            NpcMsg::RequestHire,
+            Some(expected.clone()),
+        );
+
+        let inbox = collect_npc_inputs(&mut controller, sender, 476, SimulationMode::Loaded);
+        assert_eq!(inbox.len(), 1);
+        assert_eq!(inbox[0].0, receiver);
+        assert!(matches!(&inbox[0].1.input, NpcInput::Msg { msg: NpcMsg::RequestHire, .. }));
+        assert_eq!(inbox[0].1.native_recruit.as_ref(), Some(&expected));
+        assert!(controller.actions.is_empty());
+        assert!(collect_npc_inputs(&mut controller, sender, 476, SimulationMode::Loaded).is_empty());
+    }
+
+    #[test]
+    fn native_loaded_msg_with_mismatched_sender_uid_routes_unattributed() {
+        let sender = NpcId::default();
+        let receiver = NpcId::default();
+        let mut controller = Controller::default();
+        let mut mismatched = provenance();
+        mismatched.source_uid = 477;
+        controller.send_msg_with_native_recruit_provenance(
+            Actor::Npc(receiver),
+            NpcMsg::RequestHire,
+            Some(mismatched),
+        );
 
+        let inbox = collect_npc_inputs(&mut controller, sender, 476, SimulationMode::Loaded);
+        assert_eq!(inbox.len(), 1, "the native message route is unchanged");
+        assert!(inbox[0].1.native_recruit.is_none(), "bad metadata is not attributed");
+    }
+
+    #[test]
+    fn simulated_mode_keeps_native_msg_routing_and_existing_non_msg_filter() {
+        let sender = NpcId::default();
+        let receiver = NpcId::default();
+        let mut controller = Controller::default();
+        controller.send_msg(Actor::Npc(receiver), NpcMsg::RequestHire);
