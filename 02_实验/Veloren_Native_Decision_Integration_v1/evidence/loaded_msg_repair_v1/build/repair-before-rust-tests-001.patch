+fn collect_npc_inputs(
+    controller: &mut Controller,
+    sender_id: crate::data::npc::NpcId,
+    sender_uid: u64,
+    mode: SimulationMode,
+) -> Vec<(crate::data::npc::NpcId, NpcInboxEntry)> {
+    let mut inputs = Vec::new();
+    controller.retain_actions_with_provenance(|action, provenance| match action {
+        NpcAction::Msg { to, msg } => {
+            if let Actor::Npc(target_id) = to {
+                let provenance = provenance
+                    .filter(|provenance| provenance.source_uid == sender_uid)
+                    .cloned();
+                inputs.push((
+                    *target_id,
+                    NpcInboxEntry {
+                        input: NpcInput::Msg {
+                            from: sender_id.into(),
+                            msg: msg.clone(),
+                        },
+                        native_recruit: provenance,
+                    },
+                ));
+            } else {
+                // TODO: Send to players?
+            }
+            Err("simulate_npcs_msg_consumed_in_rtsim")
+        },
+        NpcAction::Say(_, _) | NpcAction::Attack(_) | NpcAction::Dialogue(_, _) => {
+            if matches!(mode, SimulationMode::Loaded) {
+                Ok(())
+            } else {
+                Err("simulate_npcs_unloaded_mode_filter")
+            }
+        },
+    });
+    inputs
+}
