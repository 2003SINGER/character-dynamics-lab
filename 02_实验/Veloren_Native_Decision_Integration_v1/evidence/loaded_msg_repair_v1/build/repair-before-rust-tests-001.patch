+fn hire_until_json(hire_until: Option<Time>) -> Value {
+    match hire_until {
+        Some(time) if time.0.is_finite() => json!(time.0),
+        Some(_) => json!("infinity"),
+        None => Value::Null,
+    }
+}
+
+pub(super) fn drain_recruit_receipts(rtsim: &mut RtSim) {
+    let receipts = {
+        let mut data = rtsim.state.data_mut();
+        data.npcs
+            .iter_mut()
+            .flat_map(|(_, npc)| std::mem::take(&mut npc.controller.native_recruit_receipts))
+            .collect::<Vec<_>>()
+    };
+    if receipts.is_empty() {
+        return;
+    }
+
+    let events = {
+        let mut data = rtsim.state.data_mut();
+        receipts
+            .into_iter()
+            .map(|receipt| {
+                let provenance = receipt.provenance;
+                let leader_id = npc_id_by_uid(&data, provenance.source_uid);
+                let recipient_id = npc_id_by_uid(&data, provenance.target_uid);
+                if let Some(leader_id) = leader_id
+                    && let Some(task) = data.npcs.get_mut(leader_id).and_then(|leader| {
+                        leader.controller.native_recruit.as_mut()
+                    })
+                    && task.request_id == provenance.request_id
+                    && task.target_uid == provenance.target_uid
+                {
+                    match receipt.event {
+                        "native_recruit_hire_input_consumed" => task.hire_input_consumed = true,
+                        "native_recruit_hire_effect_applied" => {
+                            task.hire_effect_applied = true;
+                            task.hire_until = receipt.hire_until;
+                        },
+                        _ => {},
+                    }
+                }
+                let mut event = json!({
+                    "event":receipt.event,
+                    "request_id":provenance.request_id,
+                    "source_uid":provenance.source_uid,
+                    "target_uid":provenance.target_uid,
+                    "leader_uid":provenance.source_uid,
+                    "recipient_uid":provenance.target_uid,
+                    "leader_npc_id":leader_id.map(|id| format!("{id:?}")),
+                    "recipient_npc_id":recipient_id.map(|id| format!("{id:?}")),
+                    "time":receipt.time.0,
+                    "decision_source":provenance.decision_source,
+                    "hire_until":hire_until_json(receipt.hire_until),
+                });
+                if matches!(
+                    receipt.event,
+                    "native_recruit_msg_delivered_to_inbox"
+                        | "native_recruit_hire_input_consumed"
+                ) {
+                    event["msg_kind"] = json!("RequestHire");
+                }
+                event
+            })
+            .collect::<Vec<_>>()
+    };
+    for event in events {
+        emit(rtsim, event);
+    }
 }
 
