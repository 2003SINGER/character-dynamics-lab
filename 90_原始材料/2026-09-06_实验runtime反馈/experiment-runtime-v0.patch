+StateDelta semantic_delta(const Appraisal& appraisal,
+                          const Personality& personality) {
+    StateDelta delta;
+    for (const AppraisalSignal& signal : appraisal.semantic_signals) {
+        const double strength = std::clamp(signal.intensity, 0.0, 1.0);
+        switch (signal.kind) {
+        case AppraisalSignalKind::GoalCompletion:
+            // Preserve the old demo response while moving ownership from X
+            // into U. This is still a placeholder coefficient, not evidence.
+            delta.task_pressure -= 0.85 * strength;
+            delta.anxiety -= 0.55 * strength;
+            delta.satisfaction += 0.32 * strength;
+            break;
+        }
+    }
+    (void)personality; // reserved for signal-specific response modulation
+    return delta;
+}
