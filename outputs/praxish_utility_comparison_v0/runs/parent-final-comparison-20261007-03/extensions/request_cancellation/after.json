  "praxish_scenario": {
    "schema_version": 1,
    "scenario_id": "worker_request_activity_v0",
    "description": "A worker balances a finite restocking task with a visitor request. The paired conditions differ only by a visible request event.",
    "seed": "0x5eed1234",
    "turns": 8,
    "characters": [
      {
        "name": "worker",
        "goals": [
          {
            "id": "keep_working",
            "utility": 1,
            "conditions": [
              "practice.restock.worker.phase!working"
            ]
          },
          {
            "id": "finish_work",
            "utility": 5,
            "conditions": [
              "practice.restock.worker.phase!complete"
            ]
          },
          {
            "id": "serve_visitor",
            "utility": 10,
            "conditions": [
              "practice.request.worker.Visitor.status!served"
            ]
          }
        ]
      },
      {
        "name": "visitor",
        "goals": [
          {
            "id": "cancel_request",
            "utility": 1,
            "conditions": [
              "practice.request.worker.visitor.status!cancelled"
            ]
          }
        ]
      }
    ],
    "practices": [
      {
        "id": "restock",
        "name": "[Worker] is restocking",
        "roles": [
          "Worker"
        ],
        "init": [
          "insert practice.restock.Worker.phase!waiting"
        ],
        "actions": [
          {
            "name": "[Actor]: Start restocking",
            "conditions": [
              "eq Actor Worker",
              "practice.restock.Worker.phase!waiting"
            ],
            "outcomes": [
              "delete practice.restock.Worker.phase",
              "insert practice.restock.Worker.phase!working"
            ]
          },
          {
            "name": "[Actor]: Finish restocking",
            "conditions": [
              "eq Actor Worker",
              "practice.restock.Worker.phase!working"
            ],
            "outcomes": [
              "delete practice.restock.Worker.phase",
              "insert practice.restock.Worker.phase!complete"
            ]
          }
        ]
      },
      {
        "id": "request",
        "name": "[Visitor] has asked [Worker] for help",
        "roles": [
          "Worker",
          "Visitor"
        ],
        "init": [
          "insert practice.request.Worker.Visitor.status!pending"
        ],
        "actions": [
          {
            "name": "[Actor]: Answer [Visitor]'s request",
            "conditions": [
              "eq Actor Worker",
              "practice.request.Worker.Visitor.status!pending"
            ],
            "outcomes": [
              "delete practice.request.Worker.Visitor.status",
              "insert practice.request.Worker.Visitor.status!served"
            ]
          },
          {
            "name": "[Actor]: Wait for [Worker] to answer",
            "conditions": [
              "eq Actor Visitor",
              "practice.request.Worker.Visitor.status!pending"
            ],
            "outcomes": []
          },
          {
            "name": "[Actor]: Cancel [Worker]'s request",
            "conditions": [
              "eq Actor Visitor",
              "practice.request.Worker.Visitor.status!pending"
            ],
            "outcomes": [
              "delete practice.request.Worker.Visitor.status",
              "insert practice.request.Worker.Visitor.status!cancelled"
            ]
          }
        ]
      }
    ],
    "initial_practice_instances": [
      "insert practice.restock.worker"
    ],
    "conditions": {
      "run": {
        "events": [
          {
            "before_turn": 1,
